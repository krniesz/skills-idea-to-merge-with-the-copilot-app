<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="url"
      spellcheck="false"
      placeholder="example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL with or without <code>https://</code> to create a shareable <code>mona-</code> link.</p>
<p id="status-message" class="status-message" role="status" aria-live="polite"></p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>

<script>
  import { createSlug, formatBookmark, loadBookmarks, normalizeUrl } from '../lib/bookmarks.mjs';

  const storageKey = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const urlInput = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const statusMessage = document.getElementById('status-message');
  let bookmarks = [];

  function showMessage(message) {
    if (statusMessage) statusMessage.textContent = message;
  }

  function saveBookmarks() {
    try {
      localStorage.setItem(storageKey, JSON.stringify(bookmarks));
      return true;
    } catch {
      showMessage('Storage is unavailable, so this bookmark could not be saved.');
      return false;
    }
  }

  function renderBookmarks() {
    if (!list || !emptyState || !listHeader) return;

    list.replaceChildren();
    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createTextNode(' :: ');
      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          showMessage(`Copied ${bookmark.slug}.`);
        } catch {
          showMessage('Could not access the clipboard. Select and copy the slug instead.');
        }
      });

      item.append(link, separator, slug, copyButton);
      list.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  try {
    bookmarks = loadBookmarks(localStorage.getItem(storageKey));
  } catch {
    showMessage('Saved bookmarks could not be read from this browser.');
  }
  renderBookmarks();

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    try {
      const normalizedUrl = normalizeUrl(urlInput?.value ?? '');
      if (!normalizedUrl) {
        showMessage('Enter a valid web URL to save.');
        urlInput?.focus();
        return;
      }

      const bookmark = { url: normalizedUrl, slug: createSlug() };
      bookmarks = [...bookmarks, bookmark];
      if (!saveBookmarks()) {
        bookmarks = bookmarks.slice(0, -1);
        renderBookmarks();
        return;
      }

      renderBookmarks();
      form.reset();
      showMessage(`Saved ${formatBookmark(bookmark)}.`);
    } catch {
      showMessage('The bookmark could not be added. Please try again.');
    }
  });

  document.getElementById('clear-all')?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks from this device?')) return;

    bookmarks = [];
    let storageUpdated = true;
    try {
      localStorage.removeItem(storageKey);
    } catch {
      storageUpdated = false;
    }
    renderBookmarks();
    showMessage(storageUpdated
      ? 'All bookmarks cleared.'
      : 'Bookmarks were cleared from the list, but browser storage could not be updated.');
  });
</script>
